# JOE Store Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env or .env.local to version control

# Production URL (must match Vercel production deployment and Supabase Auth Site URL)
NEXT_PUBLIC_SITE_URL=https://joes-store-jomohamads-projects.vercel.app

# Supabase Configuration (get from Supabase Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Resend Email Service (get from Resend Dashboard > API Keys)
# Required for newsletter campaigns and transactional emails
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=JOE Store <noreply@your-verified-domain.com>

# Optional: Supabase Service Role Key (for admin/server operations only)
# Keep this secret! Only use in Vercel Production environment, never in NEXT_PUBLIC_*
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: Payment Provider (Stripe, etc.)
# PAYMENT_PROVIDER=stripe
# STRIPE_SECRET_KEY=sk_your_stripe_secret_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Optional: NEXTAUTH (if using NextAuth.js)
# NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
# NEXTAUTH_URL=https://joes-store-jomohamads-projects.vercel.app

# Supabase Auth External Providers (configure in Supabase Dashboard > Authentication > Providers)
# Google OAuth - Client ID and Secret from Google Cloud Console
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-google-client-id
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your-google-client-secret

# Supabase Auth SMS (Twilio)
# SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=your-twilio-auth-token

# Optional: SendGrid SMTP for Supabase Auth emails
# SENDGRID_API_KEY=your-sendgrid-api-key